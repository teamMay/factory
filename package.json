{
  "name": "@adrien-may/factory",
  "version": "2.1.0",
  "description": "🏭 Testing made easier with factories for your entities/models.",
  "keywords": [
    "factories",
    "factory",
    "fixtures",
    "fixtures-replacement",
    "strapi",
    "testing",
    "tests",
    "typeorm",
    "typescript"
  ],
  "homepage": "https://github.com/teamMay/factory#readme",
  "license": "ISC",
  "author": "Adrien Brunet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamMay/factory.git"
  },
  "files": [
    "dist/**/*"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "check-tsc": "tsc -p tsconfig.json --noEmit",
    "check-all": "yarn lint && yarn fmt:check && yarn check-tsc",
    "fix-all": "yarn lint:fix && yarn fmt",
    "prepare": "husky",
    "prepublish": "yarn prebuild && tsc --project ./tsconfig.build.json",
    "test": "jest"
  },
  "devDependencies": {
    "@payloadcms/db-sqlite": "3.84.1",
    "@swc/core": "1.15.40",
    "@swc/jest": "0.2.39",
    "@tsconfig/node24": "^24.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/sinon": "^21.0.1",
    "codecov": "^3.8.3",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.66.0",
    "payload": "3.84.1",
    "reflect-metadata": "0.2.2",
    "rimraf": "^6.1.3",
    "sinon": "^22.0.0",
    "sqlite3": "^6.0.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.29",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "payload": ">=3.79.1",
    "typeorm": ">0.3.25"
  },
  "peerDependenciesMeta": {
    "payload": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.12.0"
}
