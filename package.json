{
  "name": "@adrien-may/factory",
  "version": "2.0.3",
  "description": "🏭 Testing made easier with factories for your entities/models.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"src/**/*.(js|ts)\"",
    "format:fix": "prettier --write \"src/**/*.(js|ts)\" --fix",
    "check-lint": "eslint",
    "check-tsc": "tsc -p tsconfig.json --noEmit",
    "check-format": "prettier --check \"src/**/*.(js|ts)\"",
    "check-all": "yarn check-lint && yarn check-tsc && yarn check-format",
    "check-all-fix": "yarn check-lint && yarn check-tsc && yarn check-format --fix",
    "prepare": "husky",
    "prepublish": "yarn prebuild && tsc --project ./tsconfig.build.json",
    "test": "jest"
  },
  "author": "Adrien Brunet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamMay/factory.git"
  },
  "keywords": [
    "factory",
    "testing",
    "typescript",
    "factories",
    "typeorm",
    "strapi",
    "tests",
    "fixtures",
    "fixtures-replacement"
  ],
  "homepage": "https://github.com/teamMay/factory#readme",
  "license": "ISC",
  "sideEffects": false,
  "devDependencies": {
    "@payloadcms/db-sqlite": "^3.65.0",
    "@swc/core": "1.15.3",
    "@swc/jest": "0.2.39",
    "@tsconfig/node22": "^22.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/sinon": "^21.0.0",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "codecov": "^3.8.3",
    "eslint": "9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "payload": "^3.65.0",
    "prettier": "^3.6.2",
    "reflect-metadata": "0.2.2",
    "rimraf": "^6.1.2",
    "sinon": "^21.0.0",
    "sqlite3": "^5.1.7",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.27",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "payload": ">3.35.0",
    "typeorm": ">0.3.25"
  },
  "peerDependenciesMeta": {
    "payload": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.10.3"
}
